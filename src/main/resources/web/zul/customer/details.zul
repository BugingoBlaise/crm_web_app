<?xml version="1.0" encoding="UTF-8"?>
<zk>
    <?page title="Customer Details - ZK and Tailwind CSS"?>
    <script src="https://cdn.tailwindcss.com"/>
    <style>
        @import url("/zkau/web/styles/crm.css");
    </style>

    <div sclass="min-h-screen bg-gray-100 py-12 px-4 sm:px-6 lg:px-8">
        <div sclass="max-w-2xl mx-auto">
            <window apply="org.zkoss.bind.BindComposer"
                    viewModel="@id('vm') @init('com.example.crm.customer.viewmodel.CustomerViewModel')"
                    sclass="zk-card">

                <div sclass="bg-white rounded-xl shadow-md border border-gray-200 overflow-hidden">
                    <!-- Form Header -->
                    <div sclass="px-6 py-5 border-b border-gray-200 bg-white">
                        <label value="@load(empty vm.customer.id ? 'Add New Customer' : 'Edit Customer')" sclass="text-xl font-bold text-gray-900 block"/>
                        <label value="Enter the customer information below." sclass="text-sm text-gray-500 mt-1 block"/>
                    </div>

                    <!-- Form Body -->
                    <div sclass="p-6 space-y-5">
                        <div sclass="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label value="First Name" sclass="block text-sm font-medium text-gray-700 mb-1"/>
                                <textbox value="@bind(vm.customer.firstName)" placeholder="e.g. John"/>
                            </div>
                            <div>
                                <label value="Last Name" sclass="block text-sm font-medium text-gray-700 mb-1"/>
                                <textbox value="@bind(vm.customer.lastName)" placeholder="e.g. Doe"/>
                            </div>
                        </div>

                        <div sclass="mb-4">
                            <label value="Email" sclass="block text-sm font-medium text-gray-700 mb-1"/>
                            <textbox value="@bind(vm.customer.email)" placeholder="e.g. john.doe@example.com"/>
                        </div>

                        <div sclass="mb-4">
                            <label value="Phone Number" sclass="block text-sm font-medium text-gray-700 mb-1"/>
                            <textbox value="@bind(vm.customer.phoneNumber)" placeholder="e.g. +1234567890"/>
                        </div>

                        <div sclass="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label value="Company Name" sclass="block text-sm font-medium text-gray-700 mb-1"/>
                                <textbox value="@bind(vm.customer.companyName)" placeholder="e.g. Acme Corp"/>
                            </div>
                            <div>
                                <label value="TIN Number" sclass="block text-sm font-medium text-gray-700 mb-1"/>
                                <textbox value="@bind(vm.customer.tinNumber)" placeholder="e.g. 123-456-789"/>
                            </div>
                        </div>

                        <div sclass="mb-4">
                            <label value="National Identification" sclass="block text-sm font-medium text-gray-700 mb-1"/>
                            <textbox value="@bind(vm.customer.nationalIdentification)" placeholder="e.g. ID number"/>
                        </div>
                    </div>

                    <!-- Form Footer -->
                    <div sclass="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end items-center space-x-3">
                        <button label="Cancel" onClick="@command('cancel')" sclass="btn-secondary"/>
                        <button label="Save Customer" onClick="@command('save')" sclass="btn-primary"/>
                    </div>
                </div>

            </window>
        </div>
    </div>
</zk>
